# Accès fiches — mots de passe (le rôle est déduit du mot de passe)
VITE_ACCESS_ADMIN=jesuisleboss
VITE_ACCESS_FULL=jebosseplus
VITE_ACCESS_PARTIAL=synecom

# Domaines autorisés (séparés par des virgules ; ordre d’affichage géré dans access.ts)
# Réguliers (= FULL) : acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
# Admin (= réguliers + tests pinés en bas) : …,tcf,tcm-csc,tcm-cfr,tcm
# Alias : sante→santé, societe→société, lecture→alphabetisation, tcm_csc→tcm-csc, tcm_cfr→tcm-cfr
# FULL ignore la liste env et prend toujours tous les réguliers du catalogue (access.ts) —
# jamais TCF / TCM / TCM CSC / TCM CFR.
# ADMIN : union catalogue + liste env (nouveaux domaines jamais oubliés).
# PARTIAL : seule la liste env compte (défaut algèbre,géométrie).
VITE_ACCESS_DOMAINS_ADMIN=acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire,tcf,tcm-csc,tcm-cfr,tcm
VITE_ACCESS_DOMAINS_FULL=acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
VITE_ACCESS_DOMAINS_PARTIAL=algèbre,géométrie

# API fiches enregistrées (Worker Cloudflare).
VITE_FICHES_API_URL=https://clairfle-fiches.phuoc-van.workers.dev
