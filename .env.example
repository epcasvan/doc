# Accès fiches — mots de passe (le rôle est déduit du mot de passe)
VITE_ACCESS_ADMIN=jesuisleboss
VITE_ACCESS_FULL=jebosseplus
VITE_ACCESS_PARTIAL=synecom

# Domaines autorisés (séparés par des virgules ; ordre d’affichage géré dans access.ts)
# Réguliers : acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
# Admin (pinés en bas) : tcf,tcm-csc,tcm-cfr,tcm
# Alias acceptés : sante→santé, societe→société, lecture→alphabetisation, tcm_csc→tcm-csc, tcm_cfr→tcm-cfr
# TCM / TCM CSC / TCM CFR / TCF = réservés admin (filtrés hors FULL/PARTIAL même s’ils figurent dans l’env)
# ACM = Activités créatives et manuelles (domaine régulier, distinct de tcm-csc / tcm-cfr)
# FULL n’a pas TCF / TCM / TCM CSC / TCM CFR (même si listés ici, access.ts les filtre)
VITE_ACCESS_DOMAINS_ADMIN=acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire,tcf,tcm-csc,tcm-cfr,tcm
VITE_ACCESS_DOMAINS_FULL=acm,algèbre,alphabetisation,calligraphie,gattegno,géométrie,grammaire,jeux,santé,société,soutien-fr,vocabulaire
VITE_ACCESS_DOMAINS_PARTIAL=algèbre,géométrie
